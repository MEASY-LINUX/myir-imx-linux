#include "myd-jmx95-15x15.dts"
#include "myd-jmx95-15x15-dsi-lt9611.dtsi"
#include "myd-jmx95-15x15-lvds070c-lvds1-panel.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	vcc_ov13855: regulator-csi {
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_ov13855_power>;
		regulator-name = "VDD_CSI";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio5 2 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
	};

	ov13855_xclk: clock-ov13855 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
	};
};

&lpi2c3 {
	#address-cells = <1>;
	#size-cells = <0>;

	camera@36 {
		compatible = "ovti,ov13855";
		reg = <0x36>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_ov13855_gpio>;
		clocks = <&ov13855_xclk>;
		vdd-supply = <&vcc_ov13855>;
		powerdown-gpios = <&gpio5 13 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio5 8 GPIO_ACTIVE_LOW>;
		orientation = <2>;
		rotation = <0>;
		status = "okay";

		port {
			ov13855_out: endpoint {
				remote-endpoint = <&csi0_in>;
				clock-lanes = <0>;
				data-lanes = <1 2 3 4>;
				link-frequencies = /bits/ 64 <270000000>;
			};
		};
	};
};

&dphy_rx {
	status = "okay";
};

&mipi_csi0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			csi0_in: endpoint {
				remote-endpoint = <&ov13855_out>;
				clock-lanes = <0>;
				data-lanes = <1 2 3 4>;
			};
		};

		port@1 {
			reg = <1>;

			csi0_out: endpoint {
				remote-endpoint = <&formatter0_in>;
			};
		};
	};
};

&csi_pixel_formatter_0 {
	status = "okay";

	ports {
		port@0 {
			formatter0_in: endpoint {
				remote-endpoint = <&csi0_out>;
			};
		};

		port@1 {
			formatter0_out: endpoint {
				remote-endpoint = <&isi_ov13855_in>;
			};
		};
	};
};

&isi {
	status = "okay";

	ports {
		port@2 {
			isi_ov13855_in: endpoint {
				remote-endpoint = <&formatter0_out>;
			};
		};
	};
};

&neoisp0 {
	status = "okay";
};

&scmi_iomuxc {
	pinctrl_ov13855_power: ov13855powergrp {
		fsl,pins = <
			IMX95_PAD_XSPI1_DATA2__GPIO5_IO_BIT2	0x31e
		>;
	};

	pinctrl_ov13855_gpio: ov13855gpiogrp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO33__GPIO5_IO_BIT13	0x31e
			IMX95_PAD_XSPI1_DQS__GPIO5_IO_BIT8	0x31e
		>;
	};
};
